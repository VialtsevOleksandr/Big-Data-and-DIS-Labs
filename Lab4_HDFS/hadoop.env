# Syntax supported by the apache/hadoop Docker entrypoint (envtoconf.py).
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=0.0.0.0:9870
HDFS-SITE.XML_dfs.namenode.name.dir=file:///hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///hadoop/dfs/data
HDFS-SITE.XML_dfs.replication=3
HDFS-SITE.XML_dfs.blocksize=134217728

# Heartbeat: seconds. Recheck: milliseconds.
# Dead-node timeout = 2 * 30000 ms + 10 * 3 s = 90 s.
HDFS-SITE.XML_dfs.heartbeat.interval=3
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=30000

# Keep checksum verification enabled for the corruption experiment.
HDFS-SITE.XML_dfs.bytes-per-checksum=512
HDFS-SITE.XML_dfs.checksum.type=CRC32C
HDFS-SITE.XML_dfs.client.read.shortcircuit=false
HADOOP_HEAPSIZE_MAX=256
TZ=UTC
