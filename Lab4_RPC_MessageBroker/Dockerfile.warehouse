FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
WORKDIR /app
RUN pip install --no-cache-dir protobuf==7.36.2 grpcio==1.85.0 pika==1.4.4
COPY schema.py messaging.py ./
COPY server ./server
COPY warehouse ./warehouse
ENTRYPOINT ["python", "-m", "warehouse.main"]
